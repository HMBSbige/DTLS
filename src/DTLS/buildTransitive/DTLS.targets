<Project>

  <Target Name="_DTLSValidateStaticNativeLibrary" BeforeTargets="_ComputeAssembliesToCompileToNative;IlcCompile" DependsOnTargets="ResolvePackageAssets" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_DTLSDynamicNativeLibrary Include="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'DTLS' and ('%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'dtls_native.dll' or '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libdtls_native.so' or '%(NativeCopyLocalItems.Filename)%(NativeCopyLocalItems.Extension)' == 'libdtls_native.dylib')">
        <StaticLibraryFileName>libdtls_native.a</StaticLibraryFileName>
        <StaticLibraryFileName Condition="'%(Extension)' == '.dll'">dtls_native.lib</StaticLibraryFileName>
      </_DTLSDynamicNativeLibrary>
    </ItemGroup>

    <Error Condition="'@(_DTLSDynamicNativeLibrary)' == ''" Text="DTLS does not contain static native assets for RuntimeIdentifier '$(RuntimeIdentifier)'." />

    <PropertyGroup>
      <_DTLSStaticLibraryPath>@(_DTLSDynamicNativeLibrary->'%(RootDir)%(Directory)..\native-static\%(StaticLibraryFileName)')</_DTLSStaticLibraryPath>
      <_DTLSNativeStaticLinkerResponsePath>@(_DTLSDynamicNativeLibrary->'%(RootDir)%(Directory)..\native-static\dtls_native.link.rsp')</_DTLSNativeStaticLinkerResponsePath>
    </PropertyGroup>

    <Error Condition="!Exists('$(_DTLSStaticLibraryPath)')" Text="DTLS static native library was not found at '$(_DTLSStaticLibraryPath)'. Restore a complete DTLS package for RuntimeIdentifier '$(RuntimeIdentifier)'." />
    <Error Condition="!Exists('$(_DTLSNativeStaticLinkerResponsePath)')" Text="DTLS native static linker response file was not found at '$(_DTLSNativeStaticLinkerResponsePath)'. Restore a complete DTLS package for RuntimeIdentifier '$(RuntimeIdentifier)'." />

    <ItemGroup>
      <DirectPInvoke Include="dtls_native" />
      <NativeLibrary Include="$(_DTLSStaticLibraryPath)" />
    </ItemGroup>
  </Target>

  <!-- Append Rust's system dependencies immediately before the native link because archive order matters on Unix. -->
  <Target Name="_DTLSAddNativeStaticLinkerArguments" BeforeTargets="LinkNative" DependsOnTargets="_DTLSValidateStaticNativeLibrary" Condition="'$(PublishAot)' == 'true'">
    <ReadLinesFromFile File="$(_DTLSNativeStaticLinkerResponsePath)">
      <Output TaskParameter="Lines" ItemName="LinkerArg" />
    </ReadLinesFromFile>
  </Target>

  <Target Name="_DTLSExcludeDynamicNativeLibraryFromAotPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="_DTLSValidateStaticNativeLibrary" Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_DTLSDynamicNativeLibrary)" />
    </ItemGroup>
  </Target>

</Project>
